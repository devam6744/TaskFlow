# Environment Configuration for TaskFlow

# Django Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Supabase PostgreSQL)
# Get from Supabase Project Settings -> Database -> Connection string (URI)
# e.g., postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Supabase Storage & Services (For Attachments)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=taskflow-attachments

# Celery & Upstash Redis (rediss:// for TLS)
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# Email Configuration (Gmail SMTP or Console)
# EMAIL_PROVIDER: 'smtp' for real emails, 'console' for terminal logging
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
# Spaces in App Password will be automatically stripped:
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
EMAIL_FROM=noreply@taskflow.dev

# AI Integration (v2 Gemini API)
GEMINI_API_KEY=
