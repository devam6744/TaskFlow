# ==============================================================================
# TaskFlow Production Environment Variables Template
# ==============================================================================
# Copy this template and set appropriate secret values in your cloud host (Render/Railway/Vercel).
# NEVER commit the filled .env file with real secrets to GitHub!

# --- Django Security ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-secure-random-64-character-secret-key-here
DJANGO_ALLOWED_HOSTS=taskflow-api.onrender.com,yourcustomdomain.com

# --- Database (Supabase PostgreSQL) ---
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_ref.supabase.co:5432/postgres
CONN_MAX_AGE=0

# --- Redis (Upstash Serverless Redis with TLS) ---
# Format: rediss://default:[PASSWORD]@[HOST].upstash.io:6379
REDIS_URL=rediss://default:your_redis_token@your_redis_host.upstash.io:6379

# --- Cross-Origin Resource Sharing (CORS & CSRF) ---
# Comma-separated list of your Vercel frontend URLs
CORS_ALLOWED_ORIGINS=https://taskflow-app.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://taskflow-app.vercel.app,https://*.vercel.app

# --- Email Notifications (Gmail SMTP) ---
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_gmail_app_password
EMAIL_FROM=TaskFlow <your_email@gmail.com>

# --- Optional Sentry Error Monitoring ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Frontend Environment Variables (Set in Vercel) ---
# VITE_API_BASE_URL=https://taskflow-api.onrender.com/api/v1
